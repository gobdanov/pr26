        <Image Source="/imgs/airplane-arrival_1f6ec.png" Height="26" Margin="0,60,11,0" VerticalAlignment="Top" HorizontalAlignment="Right"  Grid.Column="2"/>
        <Label Content="POBEDA" Margin="35,24,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="3" Height="26"/>
        <Label Content="06:50" Margin="43,50,0,0" x:Name="time2_lbl" VerticalAlignment="Top" HorizontalAlignment="Left"  Grid.Column="3" Height="26"/>
        <Label Content="волгоград" x:Name="to_lbl" Margin="29,76,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"  Grid.Column="3" Height="26"/>
        <Label Content="29 сентября 2025г" x:Name="date2_lbl" Margin="11,102,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="3" Height="26"/>

    </Grid>
