        <Label Content="POBEDA" Margin="35,24,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="56" Grid.Column="1" Height="26"/>
        <Label Content="05:50" x:Name="time1_lbl" Margin="43,50,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="1" Height="26"/>
