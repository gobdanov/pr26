<Page x:Class="pr26.pages.Ticket_page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr26.pages"
      mc:Ignorable="d"
      d:DesignHeight="450" MinHeight="450" d:DesignWidth="800" MinWidth="800"
      Title="Ticket_page">

    <Grid Background="#FF288EFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="25*"/>

            <RowDefinition Height="198*"/>
        </Grid.RowDefinitions>
        <Frame x:Name="Ticket_p" NavigationUIVisibility="Hidden"/>
        <Grid Grid.Row="0" Background="#FF288EFF" Grid.ColumnSpan="2" Margin="0,0,0,385" Grid.RowSpan="2">
            <Grid Grid.Row="0" Background="#FF288EFF" Grid.RowSpan="2" Height="65" VerticalAlignment="Top">
                <Image Margin="8,0,0,0" Source="/imgs/airplane_2708-fe0f.png" HorizontalAlignment="Left" Width="38" Height="35" VerticalAlignment="Center"/>
                <Label Content="управлeние авиалиниями" HorizontalAlignment="Left" Margin="58,0,0,0" VerticalAlignment="Center" FontSize="16" FontFamily="Verdana" Foreground="White" Height="29" FontWeight="Bold"/>
                <Button Content="выход" Click="ex" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Width="104"/>
            </Grid>
            <Grid Background="White" Margin="0,66,0,-388">
                <ScrollViewer>
                    <StackPanel x:Name="stack" Margin="76,54,78,39"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
